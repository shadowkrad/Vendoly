# Prisma SQLite Database (isolato per tenant)
# In produzione su Docker usare: file:/app/data/prod.db
DATABASE_URL="file:./dev.db"

# Integrazione Taaaac Core (https://taaaac.eu)
TAAAAC_CORE_URL="https://taaaac.eu"
TAAAAC_TENANT_DOMAIN="vendoly-demo.taaaac.eu"
TAAAAC_TENANT_TOKEN="tuo-token-tenant"

# Configurazione Applicativa
NEXT_PUBLIC_APP_URL="http://localhost:3000"
