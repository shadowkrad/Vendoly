generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id             String      @id @default(cuid())
  title          String
  description    String
  price          Float
  comparePrice   Float?
  stock          Int         @default(1)
  category       String
  images         String      // JSON array di URL immagini
  sku            String?     @unique
  condition      String      @default("NUOVO") // NUOVO, COME_NUOVO, OTTIMO, BUONO
  isActive       Boolean     @default(true)
  isReserved     Boolean     @default(false)
  reservedNote   String?

  // Campi dettaglio prodotto (Issue #9)
  brand          String?     // Marca (Nike, Gucci, ecc.)
  size           String?     // Taglia (M, 42, 38 EU)
  color          String?     // Colore primario
  material       String?     // Materiale/tessuto
  weight         Float?      // Peso in grammi (per spedizione)
  conditionNotes String?     // Note difetti/usura (trasparenza marketplace)
  tags           String?     // JSON array tag (["vintage","lana","inverno"])

  // Flag canali marketplace (Issue #5)
  syncFacebook Boolean     @default(false)
  syncSubito   Boolean     @default(false)
  syncEbay     Boolean     @default(false)
  syncVinted   Boolean     @default(false)

  orderItems       OrderItem[]
  channelListings  ChannelListing[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model Customer {
  id              String   @id @default(cuid())
  firstName       String
  lastName        String?
  phone           String
  email           String?
  address         String?
  fiscalCode      String?  // Codice Fiscale o P.IVA per fatturazione
  clothingSize    String?  // Taglia abiti abituale (S, M, L, XL, 48, ecc.)
  shoeSize        String?  // Taglia scarpe/sneakers (41, 42, 43, ecc.)
  preferredBrands String?  // Brand preferiti (es. Nike, Carhartt, Gucci)
  notes           String?  // Note su preferenze, taglie o wishlist
  loyaltyPoints   Int      @default(0) // Punti fedeltà accumulati
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  orders          Order[]
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  customerId      String?
  customerName    String
  customerPhone   String
  customerEmail   String?
  shippingAddress String?
  fulfillmentType String      @default("SPEDIZIONE") // SPEDIZIONE, RITIRO_IN_NEGOZIO
  status          String      @default("IN_ATTESA")   // IN_ATTESA, PAGATO, SPEDITO, COMPLETATO
  totalAmount     Float
  channel         String      @default("MARKETPLACE")    // MARKETPLACE, SUBITO, VINTED, EBAY, FACEBOOK, CASSA, WHATSAPP
  trackingCode    String?
  customer        Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @default(now()) @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int     @default(1)
  unitPrice Float
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model TenantLocalCache {
  id             String   @id @default("singleton")
  domain         String
  licenseStatus  String   @default("ATTIVO") // ATTIVO, SOSPESO, IN_SCADENZA
  enabledModules String   @default("[]")     // JSON stringified array
  brandName      String   @default("Vendoly Store")
  logoUrl        String?
  faviconUrl     String?
  primaryColor   String   @default("#0f172a")
  accentColor    String   @default("#059669")
  contactEmail   String?
  phone          String?
  lastSyncedAt   DateTime @default(now())

  // Dati Attività & Fiscale (Issue #11)
  ragioneSociale String?
  partitaIva     String?
  indirizzo      String?
  titolare       String?

  // Orari Negozio (Issue #11)
  orariFeriali   String?  @default("09:30 – 13:00 / 15:30 – 19:30")
  orariSabato    String?  @default("09:30 – 19:30 (Continuato)")
  orariDomenica  String?  @default("Chiuso")

  // Politiche di Vendita & Spedizione (Issue #11)
  sogliaSpedizioneGratis  Float?   @default(50)
  costoSpedizioneStandard Float?   @default(5.90)
  ritiroInSede            Boolean  @default(true)
  politicaReso            String?  @default("Reso garantito entro 14 giorni lavorativi dalla data di ricezione dell'ordine per capi integri e con cartellino.")
  messaggioScontrino      String?  @default("Grazie per il tuo acquisto su Vendoly! Torna a trovarci.")
}

// Annunci pubblicati sui marketplace (Issue #6)
model ChannelListing {
  id           String    @id @default(cuid())
  productId    String
  channel      String    // SUBITO, VINTED, EBAY, FACEBOOK
  status       String    @default("DRAFT") // DRAFT, ACTIVE, SOLD, ARCHIVED
  externalUrl  String?   // Link annuncio live sul marketplace
  externalId   String?   // ID annuncio sulla piattaforma esterna
  listedPrice  Float     // Prezzo specifico su quel canale
  notes        String?   // Note operative del commerciante
  publishedAt  DateTime?
  soldAt       DateTime? // Quando è stato venduto (analytics)
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([productId, channel])
}

// Template descrizioni vincenti (Issue #9)
model DescriptionTemplate {
  id           String   @id @default(cuid())
  name         String   // Es. "Sneakers Vintage Nike"
  category     String   // Categoria prodotto associata
  channel      String?  // Canale specifico o null=universale
  templateText String   // Testo con placeholder {{titolo}}, {{brand}}, ecc.
  usageCount   Int      @default(0)  // Quante volte è stato usato
  salesCount   Int      @default(0)  // Quante vendite ha generato
  isDefault    Boolean  @default(false) // Template pre-installato da Vendoly
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Referenze prezzo per categoria/brand/condizione (Issue #9)
model PriceReference {
  id         String   @id @default(cuid())
  category   String   // "Sneakers", "Borse", "Giacche"
  brand      String?  // Marca specifica o null=generico
  condition  String   // NUOVO, COME_NUOVO, OTTIMO, BUONO
  avgPrice   Float    // Prezzo medio di mercato
  minPrice   Float    // Range minimo
  maxPrice   Float    // Range massimo
  source     String   @default("VENDOLY") // VENDOLY (dalle vendite), MANUAL
  sampleSize Int      @default(0) // Su quante vendite è basato
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@unique([category, brand, condition])
}

// Dispositivi fidati registrati per accesso rapido PWA (WebAuthn/Biometria)
model RegisteredDevice {
  id           String    @id @default(cuid())
  deviceName   String    // Es. "iPhone 15 Pro", "Galaxy Tab Cassa"
  deviceType   String    @default("mobile") // "mobile" | "tablet" | "desktop"
  credentialId String    @unique // Base64URL dell'ID credenziale FIDO2
  publicKey    String    // Chiave pubblica FIDO2 codificata
  counter      BigInt    @default(0) // Contatore anti-replay FIDO2
  transports   String    @default("[]") // JSON string: ["internal", "hybrid"]
  userAgent    String?
  lastIp       String?
  status       String    @default("ACTIVE") // "ACTIVE" | "REVOKED"
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
}

// Challenge temporanee WebAuthn (durata 2 minuti)
model WebAuthnChallenge {
  id        String   @id @default(cuid())
  challenge String   @unique
  purpose   String   // "registration" | "authentication"
  targetId  String?  // "admin" o identificativo
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}
