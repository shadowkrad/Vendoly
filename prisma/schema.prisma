generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id           String      @id @default(cuid())
  title        String
  description  String
  price        Float
  comparePrice Float?
  stock        Int         @default(1)
  category     String
  images       String      // JSON array di URL immagini
  sku          String?     @unique
  condition    String      @default("NUOVO") // NUOVO, USATO_COME_NUOVO, OTTIME_CONDIZIONI
  isActive     Boolean     @default(true)

  // Flag canali marketplace (Issue #5)
  syncFacebook Boolean     @default(false)
  syncSubito   Boolean     @default(false)
  syncEbay     Boolean     @default(false)
  syncVinted   Boolean     @default(false)

  orderItems   OrderItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  customerName    String
  customerPhone   String
  customerEmail   String?
  shippingAddress String?
  fulfillmentType String      @default("SPEDIZIONE") // SPEDIZIONE, RITIRO_IN_NEGOZIO
  status          String      @default("IN_ATTESA")   // IN_ATTESA, PAGATO, SPEDITO, COMPLETATO
  totalAmount     Float
  channel         String      @default("SITO_WEB")    // SITO_WEB, SUBITO, VINTED, EBAY, FACEBOOK
  trackingCode    String?
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @default(now()) @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int     @default(1)
  unitPrice Float
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model TenantLocalCache {
  id             String   @id @default("singleton")
  domain         String
  licenseStatus  String   @default("ATTIVO") // ATTIVO, SOSPESO, IN_SCADENZA
  enabledModules String   @default("[]")     // JSON stringified array
  brandName      String   @default("Vendoly Store")
  logoUrl        String?
  primaryColor   String   @default("#0f172a")
  accentColor    String   @default("#059669")
  contactEmail   String?
  phone          String?
  lastSyncedAt   DateTime @default(now())
}
